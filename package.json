{
  "name": "field-viewer",
  "version": "0.1.0",
  "description": "Client-side field model for inspecting electron and photon packets, antiparticles, and annihilation checks.",
  "author": "Jonathan R. Reed",
  "license": "MIT",
  "homepage": "https://fieldviewer.jonathanrreed.com/",
  "keywords": [
    "field-model",
    "physics",
    "react",
    "vite",
    "canvas"
  ],
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/apply-csp-hashes.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
